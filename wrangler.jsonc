{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vitalis",
  "account_id": "ab9f6d8988145943bf8bbab313e45e6e",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vitalis",
      "database_id": "32839f2a-c054-475e-848e-5383aaf832ff"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "bf9e7b7414be48bbb10ef5c8acbdc9e9"
    },
    {
      "binding": "CACHE_SEMANTICO",
      "id": "379b5ac079b74172897634abcf43b55f"
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
